    "name": "QPCP.Promise.YesNoDisjoint",
    "path": "QPCP/Promise.lean",
    "source": "/-- No instance of any family is both a yes- and a no-instance. -/\ndef YesNoDisjoint : Prop :=\n  \u2200 (F : Family) (I : FamilyInstance F), \u00ac (Yes F I \u2227 No F I)"
   },
   "proof:S059": {
    "endLine": 498,
    "files": [
     "QPCP/Promise.lean"
    ],
    "line": 494,
    "located": "lean",
    "name": "QPCP.Promise.BoolGroundEnergy",
    "path": "QPCP/Promise.lean",
    "source": "/-- Ground energy over `m` is the minimum fraction of violated constraints. -/\ndef BoolGroundEnergy : Prop :=\n  \u2200 (n k : \u2115) (cs : List (BoolConstraint n k)), cs \u2260 [] \u2192\n    groundEnergyOn (boolHamiltonian cs).toOp / cs.length =\n      \u2a05 x : QConfig 2 n, (violationCount cs x : \u211d) / cs.length"
   }
  }
