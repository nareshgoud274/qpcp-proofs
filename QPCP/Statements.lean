import QPCP.Defs

/-!
# QPCP pilot: frozen statements

Each step is a closed proposition `QPCP.Statement.Sxxx`. A contribution proves
one of them in `QPCP/Proofs/Sxxx.lean` as `theorem QPCP.Proof.Sxxx`.

Do not edit this file in a proof pull request. If a statement looks false or
too weak, comment on its issue instead.
-/

namespace QPCP.Statement

open Matrix QPCP

/-! ## Locality -/

/-- The zero operator acts on any set of qubits. -/
def S001 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)), ActsOn S (0 : Op n)

/-- The identity acts on the empty set of qubits. -/
def S002 : Prop :=
  ∀ (n : ℕ), ActsOn (∅ : Finset (Fin n)) (1 : Op n)

/-- Locality is monotone in the support. -/
def S003 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A : Op n), S ⊆ T → ActsOn S A → ActsOn T A

/-- Sums of operators on `S` act on `S`. -/
def S004 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn S B → ActsOn S (A + B)

/-- Scalar multiples of operators on `S` act on `S`. -/
def S005 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (c : ℂ) (A : Op n), ActsOn S A → ActsOn S (c • A)

/-- Products of operators on `S` act on `S`. -/
def S006 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn S B → ActsOn S (A * B)

/-- The adjoint of an operator on `S` acts on `S`. -/
def S007 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A : Op n), ActsOn S A → ActsOn S A.conjTranspose

/-- Every operator acts on the set of all qubits. -/
def S008 : Prop :=
  ∀ (n : ℕ) (A : Op n), ActsOn (Finset.univ : Finset (Fin n)) A

/-- Operators on disjoint sets of qubits commute. -/
def S009 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A B : Op n),
    Disjoint S T → ActsOn S A → ActsOn T B → Commute A B

/-- A product of operators on `S` and on `T` acts on `S ∪ T`. -/
def S010 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn T B → ActsOn (S ∪ T) (A * B)

/-! ## Local Hamiltonians -/

/-- A local Hamiltonian is Hermitian. -/
def S011 : Prop :=
  ∀ (n k : ℕ) (H : LocalHamiltonian n k), H.toOp.IsHermitian

/-- A `k`-local Hamiltonian is also `k'`-local for `k ≤ k'`. -/
def S012 : Prop :=
  ∀ (n k k' : ℕ) (H : LocalHamiltonian n k), k ≤ k' →
    ∃ H' : LocalHamiltonian n k', H'.toOp = H.toOp

/-! ## States and energy -/

/-- Computational basis vectors are normalized. -/
def S013 : Prop :=
  ∀ (n : ℕ) (x : Config n), IsState (basisState x)

/-- Energy is additive in the operator. -/
def S014 : Prop :=
  ∀ (n : ℕ) (A B : Op n) (ψ : Config n → ℂ),
    energy (A + B) ψ = energy A ψ + energy B ψ

/-- Energy scales with real multiples of the operator. -/
def S015 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n) (ψ : Config n → ℂ),
    energy ((c : ℂ) • A) ψ = c * energy A ψ

/-- The identity has energy one on every state. -/
def S016 : Prop :=
  ∀ (n : ℕ) (ψ : Config n → ℂ), IsState ψ → energy (1 : Op n) ψ = 1

/-- Expectation values of Hermitian operators are real. -/
def S017 : Prop :=
  ∀ (n : ℕ) (A : Op n) (ψ : Config n → ℂ), A.IsHermitian →
    (dotProduct (star ψ) (A.mulVec ψ)).im = 0

/-- The energies of states are bounded below. -/
def S018 : Prop :=
  ∀ (n : ℕ) (A : Op n), BddBelow (energy A '' {ψ | IsState ψ})

/-! ## Ground energy -/

/-- The ground energy is a lower bound on the energy of every state. -/
def S019 : Prop :=
  ∀ (n : ℕ) (A : Op n) (ψ : Config n → ℂ), IsState ψ → groundEnergy A ≤ energy A ψ

/-- The ground energy is superadditive. -/
def S020 : Prop :=
  ∀ (n : ℕ) (A B : Op n), groundEnergy A + groundEnergy B ≤ groundEnergy (A + B)

/-- The ground energy scales with nonnegative real multiples. -/
def S021 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n), 0 ≤ c →
    groundEnergy ((c : ℂ) • A) = c * groundEnergy A

/-- Adding a multiple of the identity shifts the ground energy. -/
def S022 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n),
    groundEnergy (A + (c : ℂ) • (1 : Op n)) = groundEnergy A + c

open scoped ComplexOrder in
/-- Positive semidefinite operators have nonnegative ground energy. -/
def S023 : Prop :=
  ∀ (n : ℕ) (A : Op n), A.PosSemidef → 0 ≤ groundEnergy A

/-- The ground energy is attained by some state. -/
def S024 : Prop :=
  ∀ (n : ℕ) (A : Op n), ∃ ψ : Config n → ℂ, IsState ψ ∧ energy A ψ = groundEnergy A

/-- For a Hermitian operator the ground energy is an eigenvalue. -/
def S025 : Prop :=
  ∀ (n : ℕ) (A : Op n), A.IsHermitian →
    ∃ ψ : Config n → ℂ, IsState ψ ∧ A.mulVec ψ = (groundEnergy A : ℂ) • ψ

/-! ## Classical cost functions as Hamiltonians -/

/-- A basis state has energy equal to its classical cost. -/
def S026 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ) (x : Config n), energy (costOp f) (basisState x) = f x

/-- The ground energy of a classical cost operator is the minimum cost. -/
def S027 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ), groundEnergy (costOp f) = ⨅ x, f x

/-- Classical cost operators are Hermitian. -/
def S028 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ), (costOp f).IsHermitian

/-- A cost function that depends only on the qubits in `S` gives an operator on `S`. -/
def S029 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (f : Config n → ℝ),
    (∀ x y : Config n, restrict S x = restrict S y → f x = f y) → ActsOn S (costOp f)

end QPCP.Statement
