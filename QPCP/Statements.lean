import QPCP.Defs
import QPCP.Qudit
import QPCP.Promise

/-!
# QPCP pilot: frozen statements

Each step is a closed proposition `QPCP.Statement.Sxxx`. A contribution proves
one of them in `QPCP/Proofs/Sxxx.lean` as `theorem QPCP.Proof.Sxxx`.

Do not edit this file in a proof pull request. If a statement looks false or
too weak, comment on its issue instead.
-/

namespace QPCP.Statement

open Matrix QPCP

/-! ## Locality -/

/-- The zero operator acts on any set of qubits. -/
def S001 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)), ActsOn S (0 : Op n)

/-- The identity acts on the empty set of qubits. -/
def S002 : Prop :=
  ∀ (n : ℕ), ActsOn (∅ : Finset (Fin n)) (1 : Op n)

/-- Locality is monotone in the support. -/
def S003 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A : Op n), S ⊆ T → ActsOn S A → ActsOn T A

/-- Sums of operators on `S` act on `S`. -/
def S004 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn S B → ActsOn S (A + B)

/-- Scalar multiples of operators on `S` act on `S`. -/
def S005 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (c : ℂ) (A : Op n), ActsOn S A → ActsOn S (c • A)

/-- Products of operators on `S` act on `S`. -/
def S006 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn S B → ActsOn S (A * B)

/-- The adjoint of an operator on `S` acts on `S`. -/
def S007 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A : Op n), ActsOn S A → ActsOn S A.conjTranspose

/-- Every operator acts on the set of all qubits. -/
def S008 : Prop :=
  ∀ (n : ℕ) (A : Op n), ActsOn (Finset.univ : Finset (Fin n)) A

/-- Operators on disjoint sets of qubits commute. -/
def S009 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A B : Op n),
    Disjoint S T → ActsOn S A → ActsOn T B → Commute A B

/-- A product of operators on `S` and on `T` acts on `S ∪ T`. -/
def S010 : Prop :=
  ∀ (n : ℕ) (S T : Finset (Fin n)) (A B : Op n),
    ActsOn S A → ActsOn T B → ActsOn (S ∪ T) (A * B)

/-! ## Local Hamiltonians -/

/-- A local Hamiltonian is Hermitian. -/
def S011 : Prop :=
  ∀ (n k : ℕ) (H : LocalHamiltonian n k), H.toOp.IsHermitian

/-- A `k`-local Hamiltonian is also `k'`-local for `k ≤ k'`. -/
def S012 : Prop :=
  ∀ (n k k' : ℕ) (H : LocalHamiltonian n k), k ≤ k' →
    ∃ H' : LocalHamiltonian n k', H'.toOp = H.toOp

/-! ## States and energy -/

/-- Computational basis vectors are normalized. -/
def S013 : Prop :=
  ∀ (n : ℕ) (x : Config n), IsState (basisState x)

/-- Energy is additive in the operator. -/
def S014 : Prop :=
  ∀ (n : ℕ) (A B : Op n) (ψ : Config n → ℂ),
    energy (A + B) ψ = energy A ψ + energy B ψ

/-- Energy scales with real multiples of the operator. -/
def S015 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n) (ψ : Config n → ℂ),
    energy ((c : ℂ) • A) ψ = c * energy A ψ

/-- The identity has energy one on every state. -/
def S016 : Prop :=
  ∀ (n : ℕ) (ψ : Config n → ℂ), IsState ψ → energy (1 : Op n) ψ = 1

/-- Expectation values of Hermitian operators are real. -/
def S017 : Prop :=
  ∀ (n : ℕ) (A : Op n) (ψ : Config n → ℂ), A.IsHermitian →
    (dotProduct (star ψ) (A.mulVec ψ)).im = 0

/-- The energies of states are bounded below. -/
def S018 : Prop :=
  ∀ (n : ℕ) (A : Op n), BddBelow (energy A '' {ψ | IsState ψ})

/-! ## Ground energy -/

/-- The ground energy is a lower bound on the energy of every state. -/
def S019 : Prop :=
  ∀ (n : ℕ) (A : Op n) (ψ : Config n → ℂ), IsState ψ → groundEnergy A ≤ energy A ψ

/-- The ground energy is superadditive. -/
def S020 : Prop :=
  ∀ (n : ℕ) (A B : Op n), groundEnergy A + groundEnergy B ≤ groundEnergy (A + B)

/-- The ground energy scales with nonnegative real multiples. -/
def S021 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n), 0 ≤ c →
    groundEnergy ((c : ℂ) • A) = c * groundEnergy A

/-- Adding a multiple of the identity shifts the ground energy. -/
def S022 : Prop :=
  ∀ (n : ℕ) (c : ℝ) (A : Op n),
    groundEnergy (A + (c : ℂ) • (1 : Op n)) = groundEnergy A + c

open scoped ComplexOrder in
/-- Positive semidefinite operators have nonnegative ground energy. -/
def S023 : Prop :=
  ∀ (n : ℕ) (A : Op n), A.PosSemidef → 0 ≤ groundEnergy A

/-- The ground energy is attained by some state. -/
def S024 : Prop :=
  ∀ (n : ℕ) (A : Op n), ∃ ψ : Config n → ℂ, IsState ψ ∧ energy A ψ = groundEnergy A

/-- For a Hermitian operator the ground energy is an eigenvalue. -/
def S025 : Prop :=
  ∀ (n : ℕ) (A : Op n), A.IsHermitian →
    ∃ ψ : Config n → ℂ, IsState ψ ∧ A.mulVec ψ = (groundEnergy A : ℂ) • ψ

/-! ## Classical cost functions as Hamiltonians -/

/-- A basis state has energy equal to its classical cost. -/
def S026 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ) (x : Config n), energy (costOp f) (basisState x) = f x

/-- The ground energy of a classical cost operator is the minimum cost. -/
def S027 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ), groundEnergy (costOp f) = ⨅ x, f x

/-- Classical cost operators are Hermitian. -/
def S028 : Prop :=
  ∀ (n : ℕ) (f : Config n → ℝ), (costOp f).IsHermitian

/-- A cost function that depends only on the qubits in `S` gives an operator on `S`. -/
def S029 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (f : Config n → ℝ),
    (∀ x y : Config n, restrict S x = restrict S y → f x = f y) → ActsOn S (costOp f)

/-! ## Phase 2: bridge from phase 1 to general index types -/

/-- Phase 1 normalization agrees with the general notion. -/
def S030 : Prop :=
  ∀ (n : ℕ) (ψ : Config n → ℂ), IsState ψ ↔ IsStateOn ψ

/-- Phase 1 energy agrees with the general notion. -/
def S031 : Prop :=
  ∀ (n : ℕ) (A : Op n) (ψ : Config n → ℂ), energy A ψ = energyOn A ψ

/-- Phase 1 ground energy agrees with the general notion. -/
def S032 : Prop :=
  ∀ (n : ℕ) (A : Op n), groundEnergy A = groundEnergyOn A

/-- Qubit locality is qudit locality with local dimension two. -/
def S033 : Prop :=
  ∀ (n : ℕ) (S : Finset (Fin n)) (A : Op n), ActsOn S A ↔ QActsOn (q := 2) S A

/-! ## Phase 2: ground energy over a general finite index type -/

/-- Energy is additive in the operator. -/
def S034 : Prop :=
  ∀ (ι : Type) [Fintype ι] (A B : Matrix ι ι ℂ) (ψ : ι → ℂ),
    energyOn (A + B) ψ = energyOn A ψ + energyOn B ψ

/-- The energies of states are bounded below. -/
def S035 : Prop :=
  ∀ (ι : Type) [Fintype ι] (A : Matrix ι ι ℂ),
    BddBelow (energyOn A '' {ψ | IsStateOn ψ})

/-- The ground energy is a lower bound on the energy of every state. -/
def S036 : Prop :=
  ∀ (ι : Type) [Fintype ι] (A : Matrix ι ι ℂ) (ψ : ι → ℂ),
    IsStateOn ψ → groundEnergyOn A ≤ energyOn A ψ

/-- The ground energy is attained by some state. -/
def S037 : Prop :=
  ∀ (ι : Type) [Fintype ι] [Nonempty ι] (A : Matrix ι ι ℂ),
    ∃ ψ : ι → ℂ, IsStateOn ψ ∧ energyOn A ψ = groundEnergyOn A

/-- The ground energy is superadditive. -/
def S038 : Prop :=
  ∀ (ι : Type) [Fintype ι] [Nonempty ι] (A B : Matrix ι ι ℂ),
    groundEnergyOn A + groundEnergyOn B ≤ groundEnergyOn (A + B)

open scoped ComplexOrder in
/-- Positive semidefinite operators have nonnegative energy on every vector. -/
def S039 : Prop :=
  ∀ (ι : Type) [Fintype ι] (A : Matrix ι ι ℂ) (ψ : ι → ℂ),
    A.PosSemidef → 0 ≤ energyOn A ψ

open scoped ComplexOrder in
/-- An operator bounded above by the identity has energy at most one on states. -/
def S040 : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℂ) (ψ : ι → ℂ),
    (1 - A).PosSemidef → IsStateOn ψ → energyOn A ψ ≤ 1

open scoped ComplexOrder in
/-- Positive semidefinite operators have nonnegative ground energy. -/
def S041 : Prop :=
  ∀ (ι : Type) [Fintype ι] (A : Matrix ι ι ℂ), A.PosSemidef → 0 ≤ groundEnergyOn A

open scoped ComplexOrder in
/-- The ground energy is monotone in the positive semidefinite order. -/
def S042 : Prop :=
  ∀ (ι : Type) [Fintype ι] [Nonempty ι] (A B : Matrix ι ι ℂ),
    (B - A).PosSemidef → groundEnergyOn A ≤ groundEnergyOn B

/-- The ground energy of a diagonal operator is its smallest diagonal entry. -/
def S043 : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] [Nonempty ι] (f : ι → ℝ),
    groundEnergyOn (Matrix.diagonal fun x => (f x : ℂ)) = ⨅ x, f x

/-! ## Phase 2: qudit locality -/

/-- The zero operator acts on any set of qudits. -/
def S044 : Prop :=
  ∀ (q n : ℕ) (S : Finset (Fin n)), QActsOn S (0 : QOp q n)

/-- Qudit locality is monotone in the support. -/
def S045 : Prop :=
  ∀ (q n : ℕ) (S T : Finset (Fin n)) (A : QOp q n), S ⊆ T → QActsOn S A → QActsOn T A

/-- Sums of operators on `S` act on `S`. -/
def S046 : Prop :=
  ∀ (q n : ℕ) (S : Finset (Fin n)) (A B : QOp q n),
    QActsOn S A → QActsOn S B → QActsOn S (A + B)

/-- Products of operators on `S` act on `S`. -/
def S047 : Prop :=
  ∀ (q n : ℕ) (S : Finset (Fin n)) (A B : QOp q n),
    QActsOn S A → QActsOn S B → QActsOn S (A * B)

/-- Operators on disjoint sets of qudits commute. -/
def S048 : Prop :=
  ∀ (q n : ℕ) (S T : Finset (Fin n)) (A B : QOp q n),
    Disjoint S T → QActsOn S A → QActsOn T B → Commute A B

/-! ## Phase 2: normalized Hamiltonians and the relative gap -/

open scoped ComplexOrder in
/-- A normalized Hamiltonian is positive semidefinite. -/
def S049 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k), H.toOp.PosSemidef

open scoped ComplexOrder in
/-- A normalized Hamiltonian is bounded above by its number of terms. -/
def S050 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k),
    (((H.numTerms : ℂ)) • (1 : QOp q n) - H.toOp).PosSemidef

/-- The ground energy of a normalized Hamiltonian is nonnegative. -/
def S051 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k), 0 ≤ groundEnergyOn H.toOp

/-- The ground energy of a normalized Hamiltonian is at most its number of terms. -/
def S052 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k),
    groundEnergyOn H.toOp ≤ (H.numTerms : ℝ)

/-- With `a < b` and at least one term, no instance is both a yes- and a no-instance. -/
def S053 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k) (a b : ℝ),
    a < b → 0 < H.numTerms → RelYes H a → RelNo H b → False

/-- A normalized `k`-local Hamiltonian is also `k'`-local for `k ≤ k'`. -/
def S054 : Prop :=
  ∀ (q n k k' : ℕ) (H : NormalizedHamiltonian q n k), k ≤ k' →
    ∃ H' : NormalizedHamiltonian q n k', H'.toOp = H.toOp ∧ H'.numTerms = H.numTerms

/-- A cost function with values in `[0, 1]` that depends only on at most `k`
qudits is a normalized term. -/
def S055 : Prop :=
  ∀ (q n k : ℕ) (S : Finset (Fin n)) (f : QConfig q n → ℝ),
    S.card ≤ k →
    (∀ x, 0 ≤ f x ∧ f x ≤ 1) →
    (∀ x y : QConfig q n, qrestrict S x = qrestrict S y → f x = f y) →
    ∃ t : NormalizedTerm q n k, t.op = Matrix.diagonal fun x => (f x : ℂ)

/-- A normalized Hamiltonian with no terms has ground energy zero. -/
def S056 : Prop :=
  ∀ (q n k : ℕ) (H : NormalizedHamiltonian q n k),
    H.numTerms = 0 → groundEnergyOn H.toOp = 0

/-! ## The promise problem (`QPCP/Promise.lean`, `docs/spec/promise.tex`) -/

/-- Physical validity of an encoded term is equivalent to the exact rational
test `ValidRat`, which has a computable decision procedure (spec §2, Validity). -/
def S057 : Prop := QPCP.Promise.ValidDecidable

/-- No instance of any problem family is both a yes- and a no-instance (spec §4). -/
def S058 : Prop := QPCP.Promise.YesNoDisjoint

/-- For a nonempty list of Boolean constraints, the ground energy divided by the
number of constraints is the minimum fraction of violated constraints (spec §7). -/
def S059 : Prop := QPCP.Promise.BoolGroundEnergy

/-- Test A of spec §7: for `n = 1` and the constraints `(x = 1), (x = 1), (x = 0)`,
the ground energy divided by the number of terms is exactly `1/3`. -/
def S060 : Prop :=
  groundEnergyOn (QPCP.Promise.boolHamiltonian QPCP.Promise.testA).toOp /
    (QPCP.Promise.boolHamiltonian QPCP.Promise.testA).numTerms = 1 / 3

end QPCP.Statement
