import Mathlib

/-!
# QPCP pilot: core definitions

STATUS: DRAFT. These definitions have not yet been reviewed by a specialist in
Hamiltonian complexity. Every proof in this repository is only as meaningful as
these definitions. Do not edit this file in a proof pull request.

Conventions:

* `n` qubits, computational basis indexed by `Config n = Fin n → Fin 2`.
* Operators are complex matrices indexed by configurations.
* An operator "acts on" a set of qubits `S` when it is `a ⊗ 1` for some
  operator `a` on the qubits in `S`.
* The ground energy is the infimum of the energy over normalized vectors.
-/

namespace QPCP

open Matrix

noncomputable section

/-- Classical configurations (computational basis labels) of `n` qubits. -/
abbrev Config (n : ℕ) : Type := Fin n → Fin 2

/-- Operators on `n` qubits, written in the computational basis. -/
abbrev Op (n : ℕ) : Type := Matrix (Config n) (Config n) ℂ

/-- Configurations of the qubits lying in `S`. -/
abbrev SubConfig {n : ℕ} (S : Finset (Fin n)) : Type := {i : Fin n // i ∈ S} → Fin 2

/-- Restriction of a configuration to the qubits in `S`. -/
def restrict {n : ℕ} (S : Finset (Fin n)) (x : Config n) : SubConfig S :=
  fun i => x i.1

/-- Two configurations agree on every qubit outside `S`. -/
def AgreeOff {n : ℕ} (S : Finset (Fin n)) (x y : Config n) : Prop :=
  ∀ i : Fin n, i ∉ S → x i = y i

/-- `A` acts nontrivially only on the qubits in `S`: it equals `a ⊗ 1` for some
operator `a` on the qubits of `S`. -/
def ActsOn {n : ℕ} (S : Finset (Fin n)) (A : Op n) : Prop :=
  ∃ a : Matrix (SubConfig S) (SubConfig S) ℂ, ∀ x y : Config n,
    (AgreeOff S x y → A x y = a (restrict S x) (restrict S y)) ∧
    (¬ AgreeOff S x y → A x y = 0)

/-- A Hermitian term acting on at most `k` of the `n` qubits. -/
structure LocalTerm (n k : ℕ) where
  /-- The qubits the term acts on. -/
  support : Finset (Fin n)
  /-- The term touches at most `k` qubits. -/
  card_le : support.card ≤ k
  /-- The term as an operator on all `n` qubits. -/
  op : Op n
  /-- The term is Hermitian. -/
  isHermitian : op.IsHermitian
  /-- The term acts only on its support. -/
  actsOn : ActsOn support op

/-- A `k`-local Hamiltonian on `n` qubits: a finite list of `k`-local terms. -/
structure LocalHamiltonian (n k : ℕ) where
  /-- The local terms. -/
  terms : List (LocalTerm n k)

/-- The Hamiltonian as a single operator: the sum of its terms. -/
def LocalHamiltonian.toOp {n k : ℕ} (H : LocalHamiltonian n k) : Op n :=
  (H.terms.map LocalTerm.op).sum

/-- `ψ` is a normalized vector. -/
def IsState {n : ℕ} (ψ : Config n → ℂ) : Prop :=
  dotProduct (star ψ) ψ = 1

/-- The energy `⟨ψ| A |ψ⟩` (real part). -/
def energy {n : ℕ} (A : Op n) (ψ : Config n → ℂ) : ℝ :=
  (dotProduct (star ψ) (A.mulVec ψ)).re

/-- The ground energy: the infimum of the energy over normalized vectors. -/
def groundEnergy {n : ℕ} (A : Op n) : ℝ :=
  sInf (energy A '' {ψ | IsState ψ})

/-- The computational basis vector labelled by `x`. -/
def basisState {n : ℕ} (x : Config n) : Config n → ℂ :=
  Pi.single x 1

/-- The diagonal operator of a classical cost function. -/
def costOp {n : ℕ} (f : Config n → ℝ) : Op n :=
  Matrix.diagonal fun x => (f x : ℂ)

/-- Yes-instance of the local Hamiltonian promise problem: ground energy at most `a`. -/
def YesInstance {n k : ℕ} (H : LocalHamiltonian n k) (a : ℝ) : Prop :=
  groundEnergy H.toOp ≤ a

/-- No-instance of the local Hamiltonian promise problem: ground energy at least `b`. -/
def NoInstance {n k : ℕ} (H : LocalHamiltonian n k) (b : ℝ) : Prop :=
  b ≤ groundEnergy H.toOp

end

end QPCP
